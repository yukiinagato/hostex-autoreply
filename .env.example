# Hostex
HOSTEX_ACCESS_TOKEN=your_hostex_access_token
HOSTEX_API_BASE=https://api.hostex.io/v3
# (No HOSTEX_WEBHOOK_SECRET env var needed — Hostex sends a token in the
#  Hostex-Webhook-Secret-Token header on the first request and the app
#  records it into the SQLite settings row, then verifies on every
#  subsequent request.)

# Local SQLite database file (defaults to ./data/app.db)
DB_PATH=./data/app.db

# LLM keys (set whichever provider(s) you'll use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cron auth (set a random string; cron route checks it)
CRON_SECRET=set_a_random_string

# First admin's password (only used on a fresh DB to seed the admin user)
APP_PASSWORD=set_a_random_string
APP_ADMIN_USERNAME=admin

# Web Push (notifications). Generate once with:
#   pnpm exec web-push generate-vapid-keys
# and paste the output here. Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
